# Protected configurations (last for the whole run and can't be changed remotely)

log_level = info # options: debug, info, warn, error, critical (Default: info)
api_uri = https://127.0.0.1/api # (Default: None)
api_user = siaas # (Default: None)
api_pwd = siaas # (Default: None)
api_ssl_ignore_verify = true # (Default: false)
api_ssl_ca_bundle = ./ssl/siaas.crt # (Default: None)
#enable_internal_api = true # (Default: false)
#offline_mode = true # don't communicate with the server at all (Default: false)

# Runtime configurations (can be changed during runtime from published configurations in the server)

#datatransfer_loop_interval_sec = 3600 # (Default: 3600)
#disable_neighborhood_discovery = true # don't perform ARP/NDP or automatic discovery (Default: false)
#disable_portscanner = true # don't scan hosts information or vulnerabilities (Default: false)
#disable_wifi_auto_discovery = true # don't auto scan hosts in the IP network on Wi-Fi interfaces (Default: false)
#manual_hosts = 109.51.61.78,sapo.pt,google.com # (Default: None)
#neighborhood_loop_interval_sec = 900 # (Default: 900)
#nmap_portscan_timeout_sec = 600 # (Default: 600)
nmap_scripts = vuln # if commented no nmap scanning script is run. Options: auth,broadcast,brute,default,discovery,dos,exploit,external,fuzzer,intrusive,malware,nmap-vulners,safe,version,vuln,vulscan (Default: None)
#nmap_sysinfo_timeout_sec = 600 # (Default: 600)
#platform_loop_interval_sec = 300 # (Default: 300)
#portscanner_loop_interval_sec = 86400 # (Default: 86400)
#portscanner_max_parallel_workers = 1 # leaving commented means the number of workers is automatically handled (Default: None)
#scan_only_manual_hosts = true # only run the portscanner against manually configured hosts (Default: false)
#silent_mode = true # the agent will only upload configuration and status data (no Neighborhood or Portscanner data is uploaded to the server) (Default: false)
#target_specific_ports = 22,80,8080-8083 # when this setting is commented, all the open ports of each host will be scanned (Default: None)

# Web scanner runtime configurations (OWASP ZAP)
#disable_webscanner = true # don't scan configured web targets with OWASP ZAP (Default: false)
#web_targets = https://example.org,http://192.0.2.10:8080 # comma-separated URLs/hosts for the web scanner (Default: None)
#webscanner_loop_interval_sec = 21600 # (Default: 21600)
#webscanner_max_parallel_workers = 1 # ZAP scans are serialized for a shared daemon (Default: 1)
#zap_scan_mode = passive # scan weight: passive (light, spider + passive analysis, no attacks), spider (spider only), active (heavy, attacks every endpoint) (Default: passive)
#zap_spider_max_children = 10 # max child nodes the spider follows per node; lower = lighter/faster (Default: 10; use 0 for unlimited)
#zap_spider_timeout_sec = 300 # time budget for the spider phase, then it is stopped (Default: min(zap_scan_timeout_sec, 300))
#zap_passive_timeout_sec = 120 # time budget for the passive scan queue to drain in passive/spider modes (Default: 120)
#zap_ascan_timeout_sec = 900 # time budget for the active scan phase when zap_scan_mode=active (Default: zap_scan_timeout_sec)
#zap_api_base = http://127.0.0.1:8090 # OWASP ZAP daemon API base URL (Default: http://127.0.0.1:8090)
#zap_api_key = changeme # optional ZAP API key (Default: None)
#zap_scan_timeout_sec = 900 # overall ZAP scan timeout cap (Default: 900)
#zap_use_docker_daemon = true # start a dockerized ZAP daemon if the API is unavailable (Default: true)

# Metasploit assistant runtime configurations (defensive correlation only)
#disable_metasploit = true # don't correlate scanner evidence with Metasploit candidates (Default: false)
#metasploit_use_metadata_cache = true # precise CVE->module correlation from the local module metadata cache, no msfconsole spawn (Default: true)
#metasploit_metadata_path = /root/.msf4/store/modules_metadata_base.json # optional path override; auto-detected if commented (Default: auto-detect)
#metasploit_filter_by_platform = true # drop candidate modules whose platform contradicts the target OS (Default: true)
#metasploit_enable_msfconsole_search = false # fallback live msfconsole search when the metadata cache is unavailable (Default: false)
#metasploit_product_fallback_search = false # also search by product/service keywords when no CVE matches (noisy; Default: false)
#metasploit_msfconsole_path = /usr/bin/msfconsole # optional path override (Default: PATH lookup)
#metasploit_msfconsole_timeout_sec = 90 # (Default: 90)
#metasploit_search_result_limit = 5 # maximum candidate modules per service (Default: 5)
#metasploit_loop_interval_sec = 3600 # retry correlation after scanner DBs exist (Default: 3600)
#metasploit_no_data_retry_interval_sec = 300 # retry faster while portscanner/webscanner DBs are still empty (Default: 300)
#metasploit_max_parallel_workers = 2 # (Default: 2)

# Remediation advisor runtime configurations (local rules plus optional free AI: Ollama/Groq/OpenAI-compatible/Gemini)
#disable_remediation = true # don't generate remediation reports from scanner output (Default: false)
#remediation_loop_interval_sec = 3600 # (Default: 3600)
#remediation_max_report_items = 200 # maximum findings in the generated remediation report (Default: 200)
#remediation_ai_provider = local_rules # options: local_rules, ollama, groq, openai, gemini (Default: local_rules)
#remediation_ai_model = llama3.1:8b # provider-specific model; defaults: ollama=llama3.1:8b, groq=llama-3.1-8b-instant, openai=gpt-4o-mini, gemini=gemini-1.5-flash
#remediation_ollama_api_url = http://127.0.0.1:11434 # local Ollama API, used when provider=ollama (Default: http://127.0.0.1:11434)
#remediation_ai_api_base = https://api.groq.com/openai/v1 # base URL for hosted providers; auto-set per provider if commented (Default: per-provider)
#remediation_ai_api_key_env = SIAAS_AI_API_KEY # name of the environment variable holding the hosted provider API key (Default: SIAAS_AI_API_KEY)
#remediation_ai_api_key = changeme # OPTIONAL inline key; prefer the env var above so keys are never synced in configs (Default: None)
#remediation_ai_cache = true # reuse a prior AI answer when the finding evidence is unchanged (Default: true)
#remediation_ai_timeout_sec = 60 # max seconds per model response (Default: 60)
#remediation_ai_max_findings = 20 # cap *new* AI calls per remediation cycle to avoid very long loops; cached findings don't count (Default: 20)
#remediation_initial_retry_interval_sec = 300 # while there are still no findings, retry this often so results appear soon after a scan finishes (Default: 300)

# Security audit / posture summary runtime configurations (aggregates all scanner outputs)
#disable_audit = true # don't generate the organization-level security posture report (Default: false)
#audit_loop_interval_sec = 3600 # (Default: 3600)
#audit_ai_provider = local_rules # options: local_rules, ollama, groq, openai, gemini (Default: local_rules)
#audit_ai_model = llama-3.1-8b-instant # provider-specific model; same defaults as remediation_ai_model (Default: per-provider)
#audit_ollama_api_url = http://127.0.0.1:11434 # local Ollama API, used when provider=ollama (Default: http://127.0.0.1:11434)
#audit_ai_api_base = https://api.groq.com/openai/v1 # base URL for hosted providers; auto-set per provider if commented (Default: per-provider)
#audit_ai_api_key_env = SIAAS_AI_API_KEY # name of the environment variable holding the hosted provider API key (Default: SIAAS_AI_API_KEY)
#audit_ai_api_key = changeme # OPTIONAL inline key; prefer the env var above (Default: None)
#audit_ai_timeout_sec = 60 # max seconds per model response (Default: 60)
#audit_initial_retry_interval_sec = 300 # retry faster while scanners haven't produced data yet (Default: 300)

# -----------------------------------------------------------------------------
# Low-resource preset (e.g. Raspberry Pi). Uncomment this block to run light.
# The portscanner is the lightweight core; the OWASP ZAP web scanner is by far
# the heaviest component (a Java daemon + crawling/attacking), so keep it in
# passive mode (or disabled) on small devices.
# -----------------------------------------------------------------------------
#nmap_scripts = vuln                          # keep a single vuln script, not the heavier sets
#portscanner_max_parallel_workers = 1         # avoid parallel nmap on few cores
#zap_scan_mode = passive                      # no active attacking; spider + passive only
#zap_spider_max_children = 5                  # shallow crawl
#zap_spider_timeout_sec = 120                 # short spider budget
#zap_passive_timeout_sec = 90
#webscanner_loop_interval_sec = 86400         # scan web targets at most once a day
#disable_webscanner = true                    # or just turn the web scanner off entirely on a Pi
#metasploit_use_metadata_cache = false        # avoid parsing the large Metasploit metadata JSON into RAM
#metasploit_enable_msfconsole_search = false  # and don't spawn msfconsole
#metasploit_loop_interval_sec = 21600
#remediation_loop_interval_sec = 21600
